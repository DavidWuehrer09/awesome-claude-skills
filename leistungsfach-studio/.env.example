# Copy to .env.local and fill in. Never commit .env.local.

# Required for the AI tutor (https://console.anthropic.com → API keys). Server-side only.
ANTHROPIC_API_KEY=

# Optional: model (default claude-opus-5-5). claude-sonnet-5-5 is cheaper.
# CLAUDE_MODEL=claude-opus-5-5

# Optional: request timeout in ms (default 240000).
# AI_TIMEOUT_MS=240000

# Optional: server-side refusal fallback ("default" routing) is on; set to off to disable.
# AI_FALLBACKS=off

# Database. Leave empty to use the built-in local database in ./data/pglite.
# For hosting, use a PostgreSQL connection string (Supabase, Neon, Railway…).
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PGLITE_DIR=./data/pglite

# Access control. Strongly recommended for anything reachable from the internet.
# `npm start` (production) refuses to run without APP_PASSWORD unless ALLOW_NO_PASSWORD=true.
# APP_PASSWORD=choose-a-long-passphrase
# SESSION_SECRET=another-random-string
# ALLOW_NO_PASSWORD=true

# Testing/demo only: offline mock tutor (results are clearly marked as not real).
# AI_PROVIDER=mock
