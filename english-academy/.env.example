# Copy to .env.local and fill in. Never commit real values.
# Every variable is optional for local development; the app runs with none of them set
# (embedded database, demo AI, no push/email).

# --- Database -----------------------------------------------------------------
# postgres://user:pass@host:5432/db  → PostgreSQL (recommended for production)
# pglite:.data/pglite                → embedded PGlite on disk (default, development)
# pglite:memory                      → in-memory (tests)
DATABASE_URL=
DATABASE_POOL_MAX=5
# Set to "false" to skip migrations on first connection and run `npm run db:migrate` yourself.
AUTO_MIGRATE=true

# --- App ----------------------------------------------------------------------
# Public base URL, used in reminder emails and unsubscribe links.
APP_URL=http://localhost:3000
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`). Signs unsubscribe links.
APP_SECRET=
# Only for local http testing over a LAN IP: drops the Secure flag from the session cookie.
INSECURE_COOKIES=false
# Sign-ups allowed per IP per hour.
SIGNUP_RATE_LIMIT=5
# "closed" stops new registrations (existing users can still sign in).
SIGNUPS=open
# Comma-separated e-mail addresses that may open /admin (usage, costs, plans).
ADMIN_EMAILS=

# --- AI (server-side only; never prefix with NEXT_PUBLIC_) --------------------
# anthropic → real Claude API (needs ANTHROPIC_API_KEY from the Claude Console; billed per token)
# demo      → deterministic, clearly labelled demo output (default when no key is set)
# none      → AI features switched off; everything else keeps working
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Optional: another endpoint that speaks the Anthropic API (gateway/proxy). Read by the official SDK.
ANTHROPIC_BASE_URL=
# Optional cheaper model for small, frequent tasks (word enrichment, topic sorting, answer
# checking, mind-map links, follow-up questions). Defaults to AI_MODEL. E.g. claude-haiku-5-5.
AI_FAST_MODEL=
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=16000
# Safety net: real AI requests per user per rolling 24 hours, whatever the plan.
AI_DAILY_REQUEST_LIMIT=300

# --- AI allowances and budgets (see docs/COSTS.md) ------------------------------
# Plan for new accounts. Built-in plans: free, plus, unlimited.
DEFAULT_PLAN=free
# Optional: replace all plans. Monthly successful requests per category (null = unlimited)
# plus an optional monthly cost cap per account in USD. Example:
# AI_PLANS={"free":{"label":"Free","monthly":{"exercises":60,"exam_generation":2,"assessment":4,"tutor":30,"documents":5},"monthlyUsd":2}}
AI_PLANS=
# Site-wide spending limits in USD (estimated from list prices). When reached, AI pauses for
# everyone with a clear message; everything else keeps working. Strongly recommended.
AI_BUDGET_DAILY_USD=
AI_BUDGET_MONTHLY_USD=
# Prices for cost estimates when using a model not in src/server/ai/config.ts (USD per million tokens).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# "off" disables server-side refusal fallbacks on supported models.
AI_FALLBACKS=on

# --- Scheduled reminders ------------------------------------------------------
# Random string; the scheduler calls GET /api/cron/reminders with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# --- Web Push (generate with `npx web-push generate-vapid-keys`) ---------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for the push service.
VAPID_SUBJECT=mailto:you@example.com

# --- Email via Resend ---------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="English Academy <reminders@example.com>"
